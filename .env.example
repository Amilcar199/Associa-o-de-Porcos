# Base URL (para SEO alternates)
NEXTAUTH_URL=http://localhost:3000

# Tradução
# Provedor padrão sem chaves (funciona out-of-the-box): libre | Alternativas: deepl | google | aws | none
TRANSLATION_PROVIDER=libre
TARGET_LOCALES=en,es

# Opcional: URLs/keys para provedores
#LIBRETRANSLATE_URL=https://libretranslate.de/translate
#DEEPL_API_KEY=xxxxxxxx
#GOOGLE_TRANSLATE_API_KEY=xxxxxxxx
#AWS_TRANSLATE_ACCESS_KEY_ID=xxxxxxxx
#AWS_TRANSLATE_SECRET_ACCESS_KEY=xxxxxxxx
#AWS_TRANSLATE_REGION=us-east-1

# Glossário: JSON ou lista separada por vírgulas
#TRANSLATION_GLOSSARY=["Landrace","Large White","Duroc","Associação de Suínos"]
